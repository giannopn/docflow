<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.docflow.controller.NewDocumentDialogController"
      spacing="12"
      prefWidth="640"
      prefHeight="470">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <VBox spacing="8">
        <Label text="Title"/>
        <TextField fx:id="titleField" promptText="Document title"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Category"/>
        <ComboBox fx:id="categorySelector" promptText="Select category" styleClass="clean-combo"/>
    </VBox>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="Content"/>
        <StackPane VBox.vgrow="ALWAYS">
            <TextArea fx:id="contentArea" wrapText="true" prefRowCount="14" VBox.vgrow="ALWAYS"/>
            <Button fx:id="pasteClipboardButton" text="Paste clipboard" onAction="#onPasteClipboard" graphicTextGap="6" StackPane.alignment="BOTTOM_RIGHT">
                <graphic>
                    <ImageView fitHeight="16" preserveRatio="true">
                        <image>
                            <Image url="@/icons/clipboard-paste.png"/>
                        </image>
                    </ImageView>
                </graphic>
                <StackPane.margin>
                    <Insets right="10" bottom="10"/>
                </StackPane.margin>
            </Button>
        </StackPane>
    </VBox>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Label fx:id="wordCountLabel" text="Words: 0"/>
        <Label fx:id="statusLabel" text=""/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#onCancel" styleClass="admin-add-button"/>
        <Button fx:id="createButton" text="Create document" onAction="#onCreate" styleClass="dialog-ok-button"/>
    </HBox>
</VBox>
