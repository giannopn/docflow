<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.docflow.controller.DocumentInfoDialogController"
      spacing="12"
      prefWidth="420"
      prefHeight="370">

    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <Label text="Document Info" style="-fx-font-size: 18px; -fx-font-weight: 700;"/>

    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="96" prefWidth="96" maxWidth="96"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="titleValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>

        <Label text="Author:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="authorValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>

        <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="categoryValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>

        <Label text="Created:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="createdValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>

        <Label text="Modified:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="modifiedValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>

        <Label text="Version:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label fx:id="versionValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="5"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>
    </GridPane>

    <Separator maxWidth="1.7976931348623157E308"/>

    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="96" prefWidth="96" maxWidth="96"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Words:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="wordsValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>

        <Label text="Characters:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="charactersValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>

        <Label text="Paragraphs:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="paragraphsValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"
               maxWidth="1.7976931348623157E308" wrapText="true" GridPane.hgrow="ALWAYS"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Close" onAction="#onClose" styleClass="dialog-ok-button"/>
    </HBox>
</VBox>
