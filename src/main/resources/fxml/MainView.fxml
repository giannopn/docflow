<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.docflow.controller.MainController"
            prefWidth="1280" prefHeight="780">

    <left>
        <VBox spacing="12" BorderPane.alignment="CENTER"
              style="-fx-border-color: transparent #e6e9ee transparent transparent; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <Label text="Docflow" styleClass="h1"/>
            <VBox spacing="6" styleClass="card">
                <Label text="Categories"/>
                <Label fx:id="categoriesCountLabel" text="0" styleClass="h2"/>
            </VBox>

            <VBox spacing="6" styleClass="card">
                <Label text="Documents"/>
                <Label fx:id="documentsCountLabel" text="0" styleClass="h2"/>
            </VBox>

            <VBox spacing="6" styleClass="card">
                <Label text="Watched"/>
                <Label fx:id="watchedCountLabel" text="0" styleClass="h2"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="documentsTab" text="Documents">
                    <VBox spacing="12">
                        <padding>
                            <Insets top="18" right="18" bottom="4" left="18"/>
                        </padding>

                        <VBox spacing="8" style="-fx-background-color: #ffffff; -fx-border-color: #e6e9ee; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <TextField fx:id="searchTitleField" promptText="Title" onAction="#onSearch" prefWidth="220"/>
                                    <TextField fx:id="searchAuthorField" promptText="Author" onAction="#onSearch" prefWidth="200"/>
                                    <ComboBox fx:id="searchCategoryCombo" promptText="Category" prefWidth="180"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Button text="Search" onAction="#onSearch"/>
                                    <Button text="Reset" onAction="#onClearSearch"/>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="newDocumentButton" text="New document" onAction="#onCreateDocument"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="4" VBox.vgrow="ALWAYS">
                            <VBox spacing="0" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #e6e9ee; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6;">
                                <TableView fx:id="documentsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                                        <TableColumn fx:id="authorColumn" text="Author" prefWidth="150"/>
                                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="140"/>
                                        <TableColumn fx:id="createdAtColumn" text="Created" prefWidth="130"/>
                                        <TableColumn fx:id="versionColumn" text="Version" prefWidth="90"/>
                                        <TableColumn fx:id="followingColumn" text="Following" prefWidth="130"/>
                                    </columns>
                                </TableView>
                            </VBox>
                            <HBox alignment="CENTER">
                                <Label fx:id="statusLabel" text="Results: 0" style="-fx-text-fill: #6b7280;"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </Tab>
                <Tab fx:id="watchlistTab" text="Watchlist">
                    <VBox spacing="12">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <HBox spacing="10">
                            <Button text="Follow selected" onAction="#onFollowSelected"/>
                            <Button text="Unfollow selected" onAction="#onUnfollowSelected"/>
                            <Label fx:id="watchStatusLabel" text=""/>
                            <Label fx:id="updatedWatchLabel" text="Updated: 0"/>
                        </HBox>
                        <ListView fx:id="watchList" />
                    </VBox>
                </Tab>
                <Tab fx:id="usersTab" text="Users">
                    <VBox spacing="12">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <HBox spacing="10">
                            <Button text="Add user" onAction="#onAddUser"/>
                            <Label fx:id="usersStatusLabel" text=""/>
                        </HBox>
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="userFirstNameColumn" text="First name" prefWidth="140"/>
                                <TableColumn fx:id="userLastNameColumn" text="Last name" prefWidth="140"/>
                                <TableColumn fx:id="userUsernameColumn" text="Username" prefWidth="160"/>
                                <TableColumn fx:id="userRoleColumn" text="Role" prefWidth="130"/>
                                <TableColumn fx:id="userCategoriesColumn" text="Allowed categories" prefWidth="420"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab fx:id="categoriesTab" text="Categories">
                    <VBox spacing="12">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <HBox spacing="10">
                            <Button text="New category" onAction="#onAddCategory"/>
                            <Label fx:id="categoriesStatusLabel" text=""/>
                        </HBox>
                        <ListView fx:id="categoriesList" />
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
