<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.docflow.controller.DocumentDialogController"
      spacing="12"
      prefWidth="760"
      prefHeight="560">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: 700;"/>

    <HBox spacing="12">
        <GridPane hgap="10" vgap="8">
            <Label text="Author:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="authorValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="categoryValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Created:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="createdValueLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox spacing="4" alignment="TOP_RIGHT">
            <Label text="View version:" alignment="CENTER_RIGHT"/>
            <ComboBox fx:id="versionSelector" styleClass="clean-combo"/>
        </VBox>
    </HBox>

    <TextArea fx:id="contentArea" wrapText="true" prefRowCount="18" VBox.vgrow="ALWAYS"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Label fx:id="statusLabel" text=""/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" onAction="#onClose"/>
        <Button fx:id="saveButton" text="Save" onAction="#onSave"/>
    </HBox>
</VBox>
