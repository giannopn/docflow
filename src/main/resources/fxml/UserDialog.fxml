<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.docflow.controller.UserDialogController"
      spacing="12"
      prefWidth="620"
      prefHeight="520">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <HBox spacing="10">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="First name"/>
            <TextField fx:id="firstNameField" promptText="First name"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Last name"/>
            <TextField fx:id="lastNameField" promptText="Last name"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="Username"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <TextField fx:id="passwordVisibleField" promptText="Password" visible="false" managed="false"/>
            <CheckBox fx:id="showPasswordCheck" text="Show password"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Role"/>
            <ComboBox fx:id="roleSelector" promptText="Select role" styleClass="clean-combo"/>
        </VBox>
    </HBox>

    <VBox spacing="6" VBox.vgrow="ALWAYS">
        <Label text="Allowed categories"/>
        <Label text="Required for SIMPLE_USER and AUTHOR, optional for ADMIN." style="-fx-text-fill: #6b7280;"/>
        <ListView fx:id="categoriesList" styleClass="admin-select-list" VBox.vgrow="ALWAYS"/>
    </VBox>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Label fx:id="statusLabel" text=""/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#onCancel" styleClass="admin-add-button"/>
        <Button fx:id="actionButton" text="Save" onAction="#onSubmit" styleClass="dialog-ok-button"/>
    </HBox>
</VBox>
